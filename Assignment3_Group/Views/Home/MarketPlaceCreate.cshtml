@model Assignment3_Group.Models.Listings

@{
    ViewData["Title"] = "Sell an item";
}

<h1>Sell an item</h1>
<p>Add the item details. The email and phone number boxes are optional.</p>
<div class="row">
    <div class="col-md-7">
        <form asp-controller="Home" asp-action="MarketPlaceCreate" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="ListingTitle" class="form-label"></label>
                <input asp-for="ListingTitle" class="form-control" maxlength="100" />
                <span asp-validation-for="ListingTitle" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ListingDescription" class="form-label"></label>
                <textarea asp-for="ListingDescription" class="form-control" rows="4" maxlength="1000"></textarea>
                <span asp-validation-for="ListingDescription" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ListingCategory" class="form-label"></label>
                <!-- The category names come from the database. -->
                <select asp-for="ListingCategory" asp-items="ViewBag.Categories" class="form-select">
                    <option value="0">Select a category</option>
                </select>
                <span asp-validation-for="ListingCategory" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ListingPrice" class="form-label"></label>
                <input asp-for="ListingPrice" type="number" min="0.01" max="99999999.99" step="0.01" class="form-control" />
                <span asp-validation-for="ListingPrice" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ListingCondition" class="form-label"></label>
                <select asp-for="ListingCondition" class="form-select">
                    <option value="Used">Used</option>
                    <option value="New">New</option>
                </select>
                <span asp-validation-for="ListingCondition" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="ListingStatus" class="form-check-input" />
                <label asp-for="ListingStatus" class="form-check-label"></label>
            </div>
            <!-- Leave the email empty to use the account email. -->
            <div class="mb-3">
                <label asp-for="ContactEmail" class="form-label"></label>
                <input asp-for="ContactEmail" type="email" class="form-control" maxlength="254" />
                <span asp-validation-for="ContactEmail" class="text-danger"></span>
                <div class="form-text">If you leave this empty, buyers will see your account email.</div>
            </div>
            <!-- Leave the phone number empty if you do not want to share it. -->
            <div class="mb-3">
                <label asp-for="ContactPhoneNumber" class="form-label"></label>
                <input asp-for="ContactPhoneNumber" type="tel" class="form-control" maxlength="30" />
                <span asp-validation-for="ContactPhoneNumber" class="text-danger"></span>
                <div class="form-text">Only add a number if you want buyers to contact you by phone.</div>
            </div>
            <!-- The student can choose a picture for the item. -->
            <div class="mb-3">
                <label for="imageFile" class="form-label">Image (optional)</label>
                <input id="imageFile" type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <div class="form-text">Choose an image from your computer.</div>
            </div>
            <button type="submit" class="btn btn-primary">Create listing</button>
            <a asp-controller="Home" asp-action="MarketPlace" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

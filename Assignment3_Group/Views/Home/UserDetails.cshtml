@model Assignment3_Group.Models.User

@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>

<dl class="row">
    <dt class="col-sm-2">Username</dt>
    <dd class="col-sm-10">@Model.UserName</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.email</dd>

    <dt class="col-sm-2">Phone number</dt>
    <dd class="col-sm-10">
        @if (string.IsNullOrWhiteSpace(Model.PhoneNumber))
        {
            <span>Not provided</span>
        }
        else
        {
            @Model.PhoneNumber
        }
    </dd>
</dl>

<a asp-controller="Home" asp-action="MarketPlace" class="btn btn-outline-secondary">Back to marketplace</a>

@* This form signs the student out. *@
<form asp-controller="Home" asp-action="SignOut" method="post" class="mt-4">
    <button type="submit" class="btn btn-outline-secondary">Sign out</button>
</form>

@model Assignment3_Group.Models.Listings

@{
    ViewData["Title"] = "Edit Listing";
}

<h1>Edit Listing</h1>

<form asp-controller="Home" asp-action="MarketPlaceEdit" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="ListingId" />

    <div class="mb-3">
        <label asp-for="ListingTitle" class="form-label"></label>
        <input asp-for="ListingTitle" class="form-control" />
        <span asp-validation-for="ListingTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ListingDescription" class="form-label"></label>
        <textarea asp-for="ListingDescription" class="form-control" rows="4"></textarea>
        <span asp-validation-for="ListingDescription" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ListingCategory" class="form-label"></label>
        <select asp-for="ListingCategory" asp-items="ViewBag.Categories" class="form-select">
            <option value="0">Select a category</option>
        </select>
        <span asp-validation-for="ListingCategory" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ListingPrice" class="form-label"></label>
        <input asp-for="ListingPrice" class="form-control" type="number" min="0.01" max="99999999.99" step="0.01" />
        <span asp-validation-for="ListingPrice" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ListingCondition" class="form-label"></label>
        <select asp-for="ListingCondition" class="form-select">
            <option value="New">New</option>
            <option value="Used">Used</option>
        </select>
        <span asp-validation-for="ListingCondition" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="ListingStatus" class="form-check-input" />
        <label asp-for="ListingStatus" class="form-check-label"></label>
    </div>

    <div class="mb-3">
        <label asp-for="ContactEmail" class="form-label"></label>
        <input asp-for="ContactEmail" class="form-control" />
        <span asp-validation-for="ContactEmail" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ContactPhoneNumber" class="form-label"></label>
        <input asp-for="ContactPhoneNumber" class="form-control" />
        <span asp-validation-for="ContactPhoneNumber" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-controller="Home" asp-action="MyListings" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
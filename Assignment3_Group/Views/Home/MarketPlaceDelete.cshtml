@model Assignment3_Group.Models.Listings

@{
    ViewData["Title"] = "Delete Listing";
}

<h1>Delete Listing</h1>
<p>Are you sure you want to delete <strong>@Model.ListingTitle</strong>?</p>
<p>Price: NZ$ @Model.ListingPrice.ToString("0.00")</p>

<form asp-controller="Home" asp-action="MarketPlaceDelete" method="post">
    @* The name must match the controller's id parameter. *@
    <input type="hidden" name="id" value="@Model.ListingId" />
    <button type="submit" class="btn btn-danger">Yes, delete</button>
    <a asp-controller="Home" asp-action="MyListings" class="btn btn-secondary">Cancel</a>
</form>
@using Assignment3_Group.Models
@using System.Text.Json

@{
    // Check if a user is logged in.
    string? sessionData = Context.Session.GetString("CurrentUser");
    User? currentUser = null;

    if (sessionData != null)
    {
        currentUser = JsonSerializer.Deserialize<User>(sessionData);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Student Marketplace app</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Assignment3_Group.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <!-- App name on the left. -->
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Student Marketplace app
                </a>

                <!-- Open or close the menu on small screens. -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#UserLoggedIn" aria-controls="UserLoggedIn" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="UserLoggedIn"
                     class="navbar-collapse collapse">

                    <!-- Move the menu to the right on larger screens. -->
                    <ul class="navbar-nav ms-sm-auto">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="MarketPlace">
                                Market Place
                            </a>
                        </li>

                        @if (currentUser == null)
                        {
                            <!-- Show these links before login. -->
                            <li class="nav-item">
                                <a id="userDetails" class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="SignUp">
                                    Sign up
                                </a>
                            </li>
                        }
                        else
                        {
                            <!-- Show the username after login. -->
                            <li class="nav-item">
                                <a id="userDetails" class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="UserDetails">
                                    @currentUser.UserName
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Assignment3_Group -
            <a asp-area="" asp-controller="Home" asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>